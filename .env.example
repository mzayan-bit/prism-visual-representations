# ==============================================================================
# PRISM — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit .env files containing real secrets or private paths to git.
# ==============================================================================

# --- Environment & Runtime ---
PRISM_ENV=development
PRISM_LOG_LEVEL=INFO
PRISM_SEED=42

# --- Storage & Artifact Paths (Optional Overrides) ---
PRISM_DATA_DIR=data
PRISM_ARTIFACTS_DIR=artifacts
PRISM_CONFIGS_DIR=configs

# --- Future API & Dashboard Configuration ---
PRISM_API_HOST=127.0.0.1
PRISM_API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
