.pnpm-debug.log*

.next/
out/
.vercel
next-env.d.ts

# --- PRISM Data & Datasets Policy ---
# Do not commit raw or bulky processed datasets.
# Retain READMEs and manifest metadata files.
data/raw/*
!data/raw/README.md
!data/raw/**/manifest.json
data/processed/*
!data/processed/README.md
!data/processed/**/manifest.json
data/external/*
!data/external/README.md
!data/external/**/manifest.json

# --- PRISM Model Checkpoints & Weights Policy ---
# Never commit heavy binary weights/checkpoints.
artifacts/checkpoints/*
!artifacts/checkpoints/README.md
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx
*.h5
*.tflite
*.engine

# --- PRISM Experiment Run Artifacts & Outputs ---
artifacts/metrics/*
!artifacts/metrics/README.md
!artifacts/metrics/**/summary.json
artifacts/figures/*
!artifacts/figures/README.md
artifacts/reports/*
!artifacts/reports/README.md
artifacts/demo/*
!artifacts/demo/README.md
!artifacts/demo/prism_demo_campaign.json
!artifacts/demo/prism_demo_report.json
!artifacts/demo/prism_demo_report.md
!artifacts/demo/benchmark_matrix.csv
!artifacts/demo/benchmark_table.csv

# --- Logging & Experiment Trackers ---
*.log
logs/
wandb/
mlruns/
lightning_logs/
.tensorboard/
